{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/actions/**",
              "components/cards/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icon/**",
              "components/layout/**",
              "components/selection/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:lucide|Inter|Playfair Display|Roboto))/i]",
        "message": "Font not provided by the design system. Available: lucide, Inter, Playfair Display, Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|description|actions|closeable|onClose|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: type, children, description, actions, closeable, onClose, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Alert> type must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|src|alt|name|initials|status|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: size, src, alt, name, initials, status, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<AvatarGroup> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarWithText'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|src|size|status|className|key|ref|className|style|children)$/]",
        "message": "<AvatarWithText> doesn't accept that prop. Declared props: name, meta, src, size, status, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|tag|title|excerpt|author|className|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: date, tag, title, excerpt, author, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|destructive|icon|iconPosition|iconOnly|shape|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, destructive, icon, iconPosition, iconOnly, shape, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:prefix|suffix)$/]",
        "message": "<Button> iconPosition must be one of 'prefix' | 'suffix'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|rounded)$/]",
        "message": "<Button> shape must be one of 'square' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|state|required|className|id|prefixIcon|suffixIcon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, help, state, required, className, id, prefixIcon, suffixIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|error|success|disabled)$/]",
        "message": "<Input> state must be one of 'default' | 'error' | 'success' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|name|description|price|rating|options|actionLabel|actionIcon|className|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, imageAlt, name, description, price, rating, options, actionLabel, actionIcon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|label|className|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: value, max, size, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|children|className|style|key|ref|className|style|children)$/]",
        "message": "<ScrollArea> doesn't accept that prop. Declared props: height, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|state|required|className|id|options|placeholder|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, help, state, required, className, id, options, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|error|success|disabled)$/]",
        "message": "<Select> state must be one of 'default' | 'error' | 'success' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|disabled|onClick|className|key|ref|className|style|children)$/]",
        "message": "<SizeOption> doesn't accept that prop. Declared props: children, selected, disabled, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|icon|children|className|key|ref|className|style|children)$/]",
        "message": "<Status> doesn't accept that prop. Declared props: type, icon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:positive|pending|negative)$/]",
        "message": "<Status> type must be one of 'positive' | 'pending' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|label|selected|disabled|onClick|className|key|ref|className|style|children)$/]",
        "message": "<SwatchOption> doesn't accept that prop. Declared props: color, label, selected, disabled, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|onClose|closeLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, onClose, closeLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:grey|primary)$/]",
        "message": "<Tag> tone must be one of 'grey' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|state|required|className|id|tags|onRemove|placeholder|key|ref|className|style|children)$/]",
        "message": "<TagInput> doesn't accept that prop. Declared props: label, help, state, required, className, id, tags, onRemove, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagInput'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|error|success|disabled)$/]",
        "message": "<TagInput> state must be one of 'default' | 'error' | 'success' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|state|required|className|id|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: label, help, state, required, className, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|error|success|disabled)$/]",
        "message": "<TextArea> state must be one of 'default' | 'error' | 'success' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|placement|children|className|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: text, placement, children, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
